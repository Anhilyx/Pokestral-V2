{
  "version": 8,
  "name": "Holo 5G Theme",
  "sources": {
    "carto-vector": {
      "type": "vector",
      "tiles": [
        "https://tiles.basemaps.cartocdn.com/vectortiles/carto.streets/v1/{z}/{x}/{y}.mvt"
      ],
      "minzoom": 0,
      "maxzoom": 14
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#020408"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "carto-vector",
      "source-layer": "water",
      "paint": {
        "fill-color": "#05101a",
        "fill-opacity": 0.8
      }
    },
    {
      "id": "road-lines",
      "type": "line",
      "source": "carto-vector",
      "source-layer": "transportation",
      "paint": {
        "line-color": "#00ffff",
        "line-width": {
          "base": 1.5,
          "stops": [[10, 0.5], [15, 1], [20, 2]]
        },
        "line-opacity": 0.1
      }
    },
    {
      "id": "buildings-fill",
      "type": "fill",
      "source": "carto-vector",
      "source-layer": "building",
      "paint": {
        "fill-color": "#00e5ff",
        "fill-opacity": 0.05
      }
    },
    {
      "id": "buildings-outline",
      "type": "line",
      "source": "carto-vector",
      "source-layer": "building",
      "paint": {
        "line-color": "#00e5ff",
        "line-width": 1,
        "line-opacity": 0.6
      }
    },
    {
      "id": "place-labels",
      "type": "symbol",
      "source": "carto-vector",
      "source-layer": "place",
      "layout": {
        "text-field": "{name_en}",
        "text-font": ["Metropolis Regular"],
        "text-size": 12,
        "text-transform": "uppercase",
        "text-letter-spacing": 0.1
      },
      "paint": {
        "text-color": "#ffffff",
        "text-opacity": 0.7,
        "text-halo-color": "#000000",
        "text-halo-width": 2
      }
    }
  ]
}